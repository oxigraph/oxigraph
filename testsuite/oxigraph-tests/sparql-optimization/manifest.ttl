@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix :      <https://github.com/oxigraph/oxigraph/tests/sparql-optimization/manifest#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:    <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix ox:    <https://github.com/oxigraph/oxigraph/tests#> .

<>  rdf:type mf:Manifest ;
    rdfs:label "Oxigraph SPARQL optimization tests" ;
    mf:entries
    (
    :unbound_filter
    :unbound_bind
    :something_or_true
    :true_or_something
    :something_or_false
    :false_or_something
    :something_and_true
    :true_and_something
    :something_and_false
    :false_and_something
    :equal_to_same_term
    :bind_always_true
    :bind_always_false
    :if_always_true
    :if_always_false
    :exists_always_false
    :exists_union
    :exists_cartesian_product
    :push_filter
    :push_optional_filter
    :empty_union
    :implicit_grouping_on_empty
    :bgp_join_reordering
    :optional_lateral_reordering
    :nested_bind_lateral_reordering
    :lateral_optional_service
    :lateral_zero_length_path
    :filter_projection_scope
    :star_with_name
    :bind_group_subquery
    :optional_in_group_middle
    :two_hop_optional
    :self_join_chain
    :iri_in_to_values
    :filter_on_bind
    :optional_not_liftable
    :bind_not_liftable
    :graph_minus_graph_variable
    :nested_optional_for_loop
    :nested_optional_bind_from_input
    :lateral_subquery_input_bindings
    ) .


:unbound_filter rdf:type ox:QueryOptimizationTest ;
    mf:name "unbound variable in filter" ;
    mf:action <unbound_filter_input.rq> ;
    mf:result <unbound_filter_output.rq> .

:unbound_bind rdf:type ox:QueryOptimizationTest ;
    mf:name "unbound variable in bindr" ;
    mf:action <unbound_bind_input.rq> ;
    mf:result <unbound_bind_output.rq> .

:something_or_true rdf:type ox:QueryOptimizationTest ;
    mf:name "something || true" ;
    mf:action <something_or_true_input.rq> ;
    mf:result <something_or_true_output.rq> .

:true_or_something rdf:type ox:QueryOptimizationTest ;
    mf:name "true || something" ;
    mf:action <true_or_something_input.rq> ;
    mf:result <true_or_something_output.rq> .

:something_or_false rdf:type ox:QueryOptimizationTest ;
    mf:name "something || false" ;
    mf:action <something_or_false_input.rq> ;
    mf:result <something_or_false_output.rq> .

:false_or_something rdf:type ox:QueryOptimizationTest ;
    mf:name "false || something" ;
    mf:action <false_or_something_input.rq> ;
    mf:result <false_or_something_output.rq> .

:something_and_true rdf:type ox:QueryOptimizationTest ;
    mf:name "something && true" ;
    mf:action <something_and_true_input.rq> ;
    mf:result <something_and_true_output.rq> .

:true_and_something rdf:type ox:QueryOptimizationTest ;
    mf:name "true && something" ;
    mf:action <true_and_something_input.rq> ;
    mf:result <true_and_something_output.rq> .

:something_and_false rdf:type ox:QueryOptimizationTest ;
    mf:name "something && false" ;
    mf:action <something_and_false_input.rq> ;
    mf:result <something_and_false_output.rq> .

:false_and_something rdf:type ox:QueryOptimizationTest ;
    mf:name "false && something" ;
    mf:action <false_and_something_input.rq> ;
    mf:result <false_and_something_output.rq> .

:equal_to_same_term a ox:QueryOptimizationTest ;
    mf:name "equal to same term" ;
    mf:action <equal_to_same_term_input.rq> ;
    mf:result <equal_to_same_term_output.rq> .

:bind_always_true rdf:type ox:QueryOptimizationTest ;
    mf:name "BIND() always true" ;
    mf:action <bind_always_true_input.rq> ;
    mf:result <bind_always_true_output.rq> .

:bind_always_false rdf:type ox:QueryOptimizationTest ;
    mf:name "BIND() always false" ;
    mf:action <bind_always_false_input.rq> ;
    mf:result <bind_always_false_output.rq> .

:if_always_true rdf:type ox:QueryOptimizationTest ;
    mf:name "IF() always true" ;
    mf:action <if_always_true_input.rq> ;
    mf:result <if_always_true_output.rq> .

:if_always_false rdf:type ox:QueryOptimizationTest ;
    mf:name "IF() always false" ;
    mf:action <if_always_false_input.rq> ;
    mf:result <if_always_false_output.rq> .

:exists_always_false rdf:type ox:QueryOptimizationTest ;
    mf:name "EXISTS {} always false" ;
    mf:action <exists_always_false_input.rq> ;
    mf:result <exists_always_false_output.rq> .

:exists_union rdf:type ox:QueryOptimizationTest ;
    mf:name "EXISTS over UNION" ;
    mf:action <exists_union_input.rq> ;
    mf:result <exists_union_output.rq> .

:exists_cartesian_product rdf:type ox:QueryOptimizationTest ;
    mf:name "EXISTS over a cartesian product" ;
    mf:action <exists_cartesian_product_input.rq> ;
    mf:result <exists_cartesian_product_output.rq> .

:push_filter rdf:type ox:QueryOptimizationTest ;
    mf:name "push filter down" ;
    mf:action <push_filter_input.rq> ;
    mf:result <push_filter_output.rq> .

:push_optional_filter rdf:type ox:QueryOptimizationTest ;
    mf:name "push OPTIONAL filter down" ;
    mf:action <push_optional_filter_input.rq> ;
    mf:result <push_optional_filter_output.rq> .

:empty_union rdf:type ox:QueryOptimizationTest ;
    mf:name "empty UNION" ;
    mf:action <empty_union_input.rq> ;
    mf:result <empty_union_output.rq> .

:implicit_grouping_on_empty rdf:type ox:QueryOptimizationTest ;
    mf:name "Implicit grouping on empty input" ;
    mf:action <implicit_grouping_on_empty_input.rq> ;
    mf:result <implicit_grouping_on_empty_output.rq> .

:bgp_join_reordering rdf:type ox:QueryOptimizationTest ;
    mf:name "BGP join reordering" ;
    mf:action <bgp_join_reordering_input.rq> ;
    mf:result <bgp_join_reordering_output.rq> .

:optional_lateral_reordering rdf:type ox:QueryOptimizationTest ;
    mf:name "OPTIONAL converted to LATERAL reorders inner BGP by bound input" ;
    mf:action <optional_lateral_reordering_input.rq> ;
    mf:result <optional_lateral_reordering_output.rq> .

:nested_bind_lateral_reordering rdf:type ox:QueryOptimizationTest ;
    mf:name "Nested BGP below BIND is converted to LATERAL" ;
    mf:action <nested_bind_lateral_reordering_input.rq> ;
    mf:result <nested_bind_lateral_reordering_output.rq> .

:lateral_optional_service rdf:type ox:QueryOptimizationTest ;
    mf:name "LATERAL preserves OPTIONAL SERVICE error handling" ;
    mf:action <lateral_optional_service_input.rq> ;
    mf:result <lateral_optional_service_output.rq> .

:lateral_zero_length_path rdf:type ox:QueryOptimizationTest ;
    mf:name "Zero-length path is not converted to LATERAL with a bound endpoint" ;
    mf:action <lateral_zero_length_path_input.rq> ;
    mf:result <lateral_zero_length_path_output.rq> .

:filter_projection_scope rdf:type ox:QueryOptimizationTest ;
    mf:name "Filter pushdown preserves subquery projection scope" ;
    mf:action <filter_projection_scope_input.rq> ;
    mf:result <filter_projection_scope_output.rq> .

:graph_minus_graph_variable rdf:type ox:QueryOptimizationTest ;
    mf:name "GRAPH is not pushed into a MINUS that uses the graph variable" ;
    mf:action <graph_minus_graph_variable_input.rq> ;
    mf:result <graph_minus_graph_variable_output.rq> .

:nested_optional_for_loop rdf:type ox:QueryOptimizationTest ;
    mf:name "OPTIONAL nested in other OPTIONAL patterns is evaluated with a for loop" ;
    mf:action <nested_optional_for_loop_input.rq> ;
    mf:result <nested_optional_for_loop_output.rq> .

:lateral_subquery_input_bindings rdf:type ox:QueryOptimizationTest ;
    mf:name "Variables bound before a LATERAL sub-query are kept bound after it" ;
    mf:action <lateral_subquery_input_bindings_input.rq> ;
    mf:result <lateral_subquery_input_bindings_output.rq> .

:nested_optional_bind_from_input rdf:type ox:QueryOptimizationTest ;
    mf:name "Nested OPTIONAL with a conflicting BIND from input is not converted to a for loop" ;
    mf:action <nested_optional_bind_from_input_input.rq> ;
    mf:result <nested_optional_bind_from_input_output.rq> .

:star_with_name rdf:type ox:QueryOptimizationTest ;
    mf:name "star BGP joined with a name lookup is evaluated from the selective anchor" ;
    mf:action <star_with_name_input.rq> ;
    mf:result <star_with_name_output.rq> .

:bind_group_subquery rdf:type ox:QueryOptimizationTest ;
    mf:name "BGP + BIND + GROUP BY sub-query joined on a group key" ;
    mf:action <bind_group_subquery_input.rq> ;
    mf:result <bind_group_subquery_output.rq> .

:optional_in_group_middle rdf:type ox:QueryOptimizationTest ;
    mf:name "OPTIONAL in the middle of a group is evaluated after the mandatory part" ;
    mf:action <optional_in_group_middle_input.rq> ;
    mf:result <optional_in_group_middle_output.rq> .

:two_hop_optional rdf:type ox:QueryOptimizationTest ;
    mf:name "two hop OPTIONAL planned with the outer bound variable" ;
    mf:action <two_hop_optional_input.rq> ;
    mf:result <two_hop_optional_output.rq> .

:self_join_chain rdf:type ox:QueryOptimizationTest ;
    mf:name "self join through a shared variable without cartesian product" ;
    mf:action <self_join_chain_input.rq> ;
    mf:result <self_join_chain_output.rq> .

:iri_in_to_values rdf:type ox:QueryOptimizationTest ;
    mf:name "IN with IRIs becomes a join with VALUES" ;
    mf:action <iri_in_to_values_input.rq> ;
    mf:result <iri_in_to_values_output.rq> .

:filter_on_bind rdf:type ox:QueryOptimizationTest ;
    mf:name "filter on a BIND variable is evaluated as early as possible" ;
    mf:action <filter_on_bind_input.rq> ;
    mf:result <filter_on_bind_output.rq> .

:optional_not_liftable rdf:type ox:QueryOptimizationTest ;
    mf:name "OPTIONAL that is not well designed stays inside its group" ;
    mf:action <optional_not_liftable_input.rq> ;
    mf:result <optional_not_liftable_output.rq> .

:bind_not_liftable rdf:type ox:QueryOptimizationTest ;
    mf:name "BIND using a variable bound by the rest of the group stays inside its group" ;
    mf:action <bind_not_liftable_input.rq> ;
    mf:result <bind_not_liftable_output.rq> .
