@prefix ex: <http://example.com/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:g {
    ex:s ex:p "bad"^^rdf:langString, "skipped" .
    ex:s ex:p "good" .
    <http:// /s> ex:p "invalid IRI" .
    ex:s missing:p "unresolved prefix" .
    ex:s ex:p "missing datatype"^^ .
    ex:s ex:p "missing dot"
    ex:s ex:p "good after errors" .
    ex:s ex:p
}
ex:s ex:p "default graph" .
